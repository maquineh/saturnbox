file(READ "${INPUT}" spirv HEX)
string(LENGTH "${spirv}" length)
math(EXPR last "${length} - 8")
set(source "#pragma once\n#include <cstdint>\nnamespace saturn::platform {\ninline constexpr std::uint32_t kVdp1ComputeSpirv[] = {\n")
foreach(offset RANGE 0 ${last} 8)
    foreach(byte RANGE 0 3)
        math(EXPR index "${offset} + ${byte} * 2")
        string(SUBSTRING "${spirv}" ${index} 2 b${byte})
    endforeach()
    string(APPEND source "0x${b3}${b2}${b1}${b0}U,\n")
endforeach()
string(APPEND source "};\n}\n")
file(WRITE "${OUTPUT}" "${source}")
